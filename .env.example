DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moss
# MOSS E-Commerce Environment Configuration

# Set to true to switch from local mock services to Magento 2 GraphQL
VITE_USE_MAGENTO=false

# Magento 2 Headless GraphQL Endpoint
VITE_MAGENTO_GRAPHQL_URL=https://demo.magento.com/graphql

# Default Store Currency
VITE_DEFAULT_CURRENCY=USD

# Free Shipping Threshold (in USD)
VITE_FREE_SHIPPING_THRESHOLD=100

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
